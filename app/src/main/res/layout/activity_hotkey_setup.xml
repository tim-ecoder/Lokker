<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface">

    <android.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colorSurfaceVariant"
        android:title="Горячие клавиши"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section: Lokker hotkey -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_lokker_hotkey"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:padding="16dp"
                android:paddingBottom="8dp"/>

            <!-- Hotkey recorder -->
            <LinearLayout
                android:id="@+id/lokker_hotkey_recorder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/colorCardBg"
                android:padding="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <LinearLayout
                    android:id="@+id/lokker_hotkey_sequence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>

                <LinearLayout
                    android:id="@+id/rec_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="8dp">
                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@color/colorError"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hotkey_recording"
                        android:textColor="@color/colorOnSurfaceMedium"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hotkey_record_hint"
                    android:textColor="@color/colorOnSurfaceDim"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorDivider"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>

            <!-- Section: App hotkeys -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_app_hotkeys"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textAllCaps="true"
                android:letterSpacing="0.05"
                android:padding="16dp"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:id="@+id/app_hotkeys_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
